-- 🎶 NOME DA MÚSICA
-- ============================================================

local function updateSongName()

	local id = getId(IdBox.Text)

	if not id then
		SongName.Text = "ID inválido"
		return
	end

	SongName.Text = "Carregando música..."

	task.spawn(function()

		local success,info = pcall(function()
			return MarketplaceService:GetProductInfo(
				tonumber(id),
				Enum.InfoType.Asset
			)
		end)

		if success and info and info.Name then
			SongName.Text = tostring(info.Name)
		else
			SongName.Text = "Música • ID " .. id
		end

	end)
end

-- ============================================================
-- 🔄 TROCAR MÚSICA — CORRIGIDO
-- ============================================================

local changingMusic = false

local function loadMusic(text)

	if changingMusic then
		return
	end

	local id = getId(text)

	if not id then
		SongName.Text = "ID inválido"
		return
	end

	changingMusic = true

	SongName.Text = "Carregando música..."

	-- Guarda o volume e velocidade atuais
	local oldVolume = Sound and Sound.Volume or DEFAULT_VOLUME
	local oldSpeed = Sound and Sound.PlaybackSpeed or DEFAULT_SPEED

	-- Cria um Sound completamente novo
	local newSound = Instance.new("Sound")
	newSound.Name = "HenriqueMusic"
	newSound.SoundId = "rbxassetid://" .. id
	newSound.Volume = oldVolume
	newSound.PlaybackSpeed = oldSpeed
	newSound.Looped = Sound and Sound.Looped or false
	newSound.Parent = workspace

	local oldSoundReference = Sound
	Sound = newSound

	-- Carrega o novo áudio
	local loaded = false

	local connection

	connection = newSound.Loaded:Connect(function()
		loaded = true
	end)

	pcall(function()
		ContentProvider:PreloadAsync({newSound})
	end)

	local startTime = os.clock()

	while not loaded and not newSound.IsLoaded and os.clock() - startTime < 8 do
		task.wait(0.1)
	end

	-- Remove o Sound antigo somente depois
	-- que o novo já foi preparado.
	if oldSoundReference and oldSoundReference.Parent then
		oldSoundReference:Stop()
		oldSoundReference:Destroy()
	end

	if connection then
		connection:Disconnect()
	end

	IdBox.Text = id

	VolumeFill.Size = UDim2.new(
		math.clamp(newSound.Volume / MAX_VOLUME,0,1),
		0,
		1,
		0
	)

	local speedPercent = math.clamp(
		(newSound.PlaybackSpeed - MIN_SPEED) /
		(MAX_SPEED - MIN_SPEED),
		0,
		1
	)

	SpeedFill.Size = UDim2.new(
		speedPercent,
		0,
		1,
		0
	)

	SpeedValue.Text = string.format(
		"%.1fx",
		newSound.PlaybackSpeed
	)

	-- Começa o novo áudio
	newSound.TimePosition = 0
	newSound:Play()

	PauseButton.Text = "⏸️"

	updateSongName()

	changingMusic = false
end

