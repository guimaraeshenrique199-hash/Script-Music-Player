-- Giro lento → volta → tremidinha
-- ============================================================

local imageAnimationRunning = true

task.spawn(function()

	while imageAnimationRunning and RobloxImage.Parent do

		local rotate1 = TweenService:Create(
			RobloxImage,
			TweenInfo.new(
				2.8,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),
			{
				Rotation = 7
			}
		)

		rotate1:Play()
		rotate1.Completed:Wait()

		if not RobloxImage.Parent then
			break
		end

		local rotate2 = TweenService:Create(
			RobloxImage,
			TweenInfo.new(
				2.8,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),
			{
				Rotation = 0
			}
		)

		rotate2:Play()
		rotate2.Completed:Wait()

		if not RobloxImage.Parent then
			break
		end

		for i = 1,4 do

			local shakeRight = TweenService:Create(
				RobloxImage,
				TweenInfo.new(
					0.08,
					Enum.EasingStyle.Linear
				),
				{
					Rotation = 2
				}
			)

			shakeRight:Play()
			shakeRight.Completed:Wait()

			local shakeLeft = TweenService:Create(
				RobloxImage,
				TweenInfo.new(
					0.08,
					Enum.EasingStyle.Linear
				),
				{
					Rotation = -2
				}
			)

			shakeLeft:Play()
			shakeLeft.Completed:Wait()

		end

		local shakeReturn = TweenService:Create(
			RobloxImage,
			TweenInfo.new(
				0.12,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),
			{
				Rotation = 0
			}
		)

		shakeReturn:Play()
		shakeReturn.Completed:Wait()

		task.wait(0.8)

	end

end)

