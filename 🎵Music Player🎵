-- ============================================================
-- 🌈 CORES DAS BARRAS
-- ============================================================

local function getBarColor(index)

	local t = (index-1) / (BAR_COUNT-1)

	local centerBlue = math.sin(t*math.pi)

	local red = math.floor(centerBlue*10)
	local green = 255
	local blue = math.floor(30 + centerBlue*220)

	return Color3.fromRGB(red,green,blue)

end

-- ============================================================
-- 📊 VISUALIZER
-- ============================================================

local barValues = {}
local barTargets = {}
local barSeeds = {}

for i = 1,BAR_COUNT do

	barValues[i] = 0.18
	barTargets[i] = 0.18
	barSeeds[i] = (i * 17.371) % 100

end

local visualTime = 0

RunService.RenderStepped:Connect(function(dt)

	visualTime += dt

	Clock.Text = os.date("%H:%M")

	local current = Sound.TimePosition or 0
	local duration = Sound.TimeLength or 0

	CurrentTime.Text = formatTime(current)
	TotalTime.Text = formatTime(duration)

	if duration > 0 then

		local percent = math.clamp(
			current/duration,
			0,
			1
		)

		Progress.Size = UDim2.new(
			percent,
			0,
			1,
			0
		)

	else

		Progress.Size = UDim2.fromScale(0,1)

	end

	local loudness = Sound.PlaybackLoudness or 0

	local volumeReference = math.max(
		Sound.Volume,
		0.15
	)

	local audioPower = loudness / volumeReference

	audioPower = math.clamp(
		audioPower / 420,
		0,
		1
	)

	for i,bar in ipairs(Bars) do

		local seed = barSeeds[i]

		local wave1 = math.sin(
			visualTime*2.7 + seed
		)

		local wave2 = math.sin(
			visualTime*4.1 + seed*1.7
		)

		local variation =
			(wave1*0.5 + wave2*0.5)

		variation = (variation+1)/2

		local sensitivity =
			0.50 + variation*0.70

		local center =
			math.abs(
				(i-1) -
				((BAR_COUNT-1)/2)
			)

		local centerFactor =
			1 -
			(center/((BAR_COUNT-1)/2))*0.18

		local power =
			audioPower *
			sensitivity *
			centerFactor

		local target =
			0.12 + power*0.80

		target = math.clamp(
			target,
			0.12,
			0.94
		)

		barTargets[i] = target

		local smoothing

		if audioPower > 0.04 then
			smoothing = 0.32
		else
			smoothing = 0.16
		end

		barValues[i] =
			barValues[i] +
			(barTargets[i]-barValues[i]) *
			smoothing

		bar.Size = UDim2.new(
			1/BAR_COUNT,
			-4,
			barValues[i],
			0
		)

		bar.BackgroundColor3 = getBarColor(i)

	end

end)

